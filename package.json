{
  "name": "co-pilot-security-marketplace",
  "private": true,
  "version": "2.4.0-client-live-tracking",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:schema && npm run audit:mission-critical && tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:schema": "node scripts/validate-schema-contract.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:doctor": "cap doctor",
    "mobile:client:config": "node scripts/write-mobile-config.mjs client",
    "mobile:guard:config": "node scripts/write-mobile-config.mjs guard",
    "mobile:client:sync": "npm run mobile:client:config && npm run build:mobile && cap sync",
    "mobile:guard:sync": "npm run mobile:guard:config && npm run build:mobile && cap sync",
    "build:mobile": "npm run validate:schema && tsc && vite build --mode mobile",
    "mobile:audit": "node scripts/mobile-release-audit.mjs",
    "mobile:preflight": "node scripts/mobile-release-preflight.mjs",
    "mobile:native:android:add": "npx cap add android",
    "mobile:native:ios:add": "npx cap add ios",
    "mobile:native:client:android": "node scripts/prepare-native-release.mjs client android",
    "mobile:native:guard:android": "node scripts/prepare-native-release.mjs guard android",
    "mobile:native:client:ios": "node scripts/prepare-native-release.mjs client ios",
    "mobile:native:guard:ios": "node scripts/prepare-native-release.mjs guard ios",
    "mobile:native:prepare": "node scripts/prepare-native-release.mjs",
    "mobile:native:client:sync": "npm run mobile:client:config && npm run build:mobile && npx cap sync",
    "mobile:native:guard:sync": "npm run mobile:guard:config && npm run build:mobile && npx cap sync",
    "mobile:status": "node scripts/mobile-release-status.mjs",
    "mobile:push:health": "node scripts/mobile-push-ops.mjs health",
    "mobile:push:worker": "node scripts/mobile-push-ops.mjs worker",
    "mobile:evidence": "node scripts/mobile-release-evidence.mjs",
    "mobile:manifest": "node scripts/mobile-release-manifest.mjs",
    "mobile:manifest:verify": "node scripts/verify-mobile-release-manifest.mjs",
    "mobile:rc": "node scripts/mobile-release-candidate.mjs",
    "mobile:backend:ready": "node scripts/mobile-backend-readiness.mjs",
    "mobile:freeze": "node scripts/mobile-source-freeze.mjs",
    "mobile:summary": "node scripts/mobile-release-summary.mjs",
    "mobile:activation:plan": "node scripts/mobile-production-activation-plan.mjs",
    "mobile:inputs:check": "node scripts/mobile-private-input-check.mjs",
    "mobile:backend:contract": "node scripts/mobile-backend-contract.mjs",
    "mobile:native:plan": "node scripts/mobile-native-workspace-plan.mjs",
    "mobile:blockers": "node scripts/mobile-release-blockers.mjs",
    "mobile:native:isolated:prepare": "node scripts/prepare-isolated-native-release.mjs",
    "mobile:native:isolated:sync": "node scripts/sync-isolated-native-release.mjs",
    "mobile:native:isolation:audit": "node scripts/mobile-native-isolation-audit.mjs",
    "mobile:android:ready": "node scripts/android-release-readiness.mjs",
    "mobile:android:debug:evidence": "node scripts/android-debug-artifact-evidence.mjs",
    "mobile:android:debug:verify": "node scripts/android-debug-artifact-verify.mjs",
    "audit:mission-critical": "node scripts/mission-critical-regression-audit.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.3",
    "@nmipayments/nmi-pay-react": "^1.0.2",
    "@supabase/supabase-js": "2.52.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "supabase": "^2.114.0",
    "typescript": "5.7.2",
    "vite": "^5.4.21"
  }
}
